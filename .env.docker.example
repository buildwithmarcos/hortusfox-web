# Docker Compose deployment settings. Copy to .env (gitignored) and fill in.
# Note: inside the container the app's own .env is generated by docker-entrypoint.sh.
# Keep passwords alphanumeric: the entrypoint interpolates them into shell/SQL.

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=
APP_TIMEZONE=UTC
# Must stay true: the entrypoint runs migrations via the asatru CLI, which only works in debug mode.
APP_DEBUG=true
APACHE_SERVER_NAME=localhost

DB_DATABASE=hortusfox
DB_USERNAME=hortusfox
DB_PASSWORD=
DB_ROOT_PASSWORD=
